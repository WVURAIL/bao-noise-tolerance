{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baonoise:schema:forecast-completion-evidence:v2",
  "title": "baonoise model-only forecast-completion evidence",
  "type": "object",
  "required": [
    "schema", "schema_version", "implementation", "bank",
    "reproducibility", "evidence_scope", "checks", "ledgers"
  ],
  "properties": {
    "schema": {"const": "baonoise-forecast-completion-evidence-v2"},
    "schema_version": {"const": 2},
    "implementation": {
      "type": "object",
      "required": [
        "bias_tolerance_sha256", "evidence_runner_sha256",
        "build_bank_wrapper_sha256", "evidence_schema_sha256",
        "report_schema"
      ],
      "properties": {
        "bias_tolerance_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_runner_sha256": {"$ref": "#/$defs/sha256"},
        "build_bank_wrapper_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_schema_sha256": {"$ref": "#/$defs/sha256"},
        "report_schema": {"const": "baonoise-bias-tolerance-v1"}
      },
      "additionalProperties": false
    },
    "bank": {
      "type": "object",
      "required": [
        "filename", "sha256", "numerical_grid_sha256", "schema_version",
        "artifact_kind", "config", "cosmology", "P_res",
        "expt_overrides", "expt_overrides_sha256", "foreground_settings",
        "foreground_settings_sha256", "time_grid", "scientific_identity"
      ],
      "properties": {
        "filename": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "numerical_grid_sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"type": "integer"},
        "artifact_kind": {"const": "bias_response"},
        "config": {"type": "string"},
        "cosmology": {"type": "string"},
        "astrophysical_model_profile": {"type": "string"},
        "P_res": {},
        "expt_overrides": {"type": "object"},
        "expt_overrides_sha256": {"$ref": "#/$defs/sha256"},
        "foreground_settings": {"type": "object"},
        "foreground_settings_sha256": {"$ref": "#/$defs/sha256"},
        "time_grid": {"type": "object"},
        "built_utc": {"type": "string", "format": "date-time"},
        "scientific_identity": {"type": "object"}
      },
      "not": {"required": ["path"]},
      "additionalProperties": false
    },
    "reproducibility": {
      "type": "object",
      "required": [
        "exact_execution_bank_sha256_retained",
        "scientific_content_reproducible", "archive_bytes_reproducible",
        "archive_variability_sources", "absolute_checkout_paths_omitted"
      ],
      "properties": {
        "exact_execution_bank_sha256_retained": {"const": true},
        "scientific_content_reproducible": {"const": true},
        "archive_bytes_reproducible": {"const": false},
        "archive_variability_sources": {
          "const": ["bank build timestamp", "NPZ ZIP member timestamps"]
        },
        "absolute_checkout_paths_omitted": {"const": true}
      },
      "additionalProperties": false
    },
    "evidence_scope": {
      "type": "object",
      "required": [
        "bin_indices", "bin_count", "redshift_bins", "selection",
        "new_telescope_data_used", "empirical_visibility_template_used",
        "absolute_checkout_paths_included"
      ],
      "properties": {
        "bin_indices": {
          "type": "array", "minItems": 1,
          "items": {"type": "integer", "minimum": 0},
          "uniqueItems": true
        },
        "bin_count": {"type": "integer", "minimum": 1},
        "redshift_bins": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["bin_index", "z_low", "z_center", "z_high"],
            "properties": {
              "bin_index": {"type": "integer", "minimum": 0},
              "z_low": {"type": "number"},
              "z_center": {"type": "number"},
              "z_high": {"type": "number"}
            },
            "additionalProperties": false
          }
        },
        "selection": {
          "enum": [
            "explicit_single_bin", "all_physical_470_608_MHz_DTV_overlaps"
          ]
        },
        "new_telescope_data_used": {"const": false},
        "empirical_visibility_template_used": {"const": false},
        "absolute_checkout_paths_included": {"const": false}
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "required": [
        "all_requested_points_have_complete_dispositions",
        "time_family_response_and_tolerance_scaling"
      ],
      "properties": {
        "all_requested_points_have_complete_dispositions": {
          "type": "object", "additionalProperties": {"const": true}
        },
        "time_family_response_and_tolerance_scaling": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["lower", "central", "upper"],
                "properties": {
                  "lower": {"$ref": "#/$defs/checkSet"},
                  "central": {"$ref": "#/$defs/checkSet"},
                  "upper": {"$ref": "#/$defs/checkSet"}
                },
                "additionalProperties": false
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "ledgers": {
      "type": "object",
      "required": [
        "perbin_noise_normalized", "combined_noise_normalized",
        "combined_fixed_physical"
      ],
      "properties": {
        "perbin_noise_normalized": {"$ref": "#/$defs/ledger"},
        "combined_noise_normalized": {"$ref": "#/$defs/ledger"},
        "combined_fixed_physical": {"$ref": "#/$defs/ledger"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkSet": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"const": true}
    },
    "ledger": {
      "type": "object",
      "required": ["estimator", "residual_amplitude", "request", "bins"],
      "properties": {
        "estimator": {"type": "object"},
        "residual_amplitude": {"type": "object"},
        "request": {"type": "object"},
        "bins": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "bin_index", "z_low", "z_center", "z_high", "points", "summary"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
